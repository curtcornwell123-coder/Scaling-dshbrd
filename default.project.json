{
  "name": "BrainrotHeist",
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Locked": true,
          "Size": [2048, 16, 2048],
          "Position": [0, -8, 0],
          "Color": [0.36, 0.62, 0.32],
          "Material": "Grass",
